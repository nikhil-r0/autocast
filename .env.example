# LLM Provider for generating objectives and narration
# (Supported: Anthropic / OpenAI / Gemini)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# TTS Provider (Optional - leave blank for silent mode)
ELEVENLABS_API_KEY=

# Antigravity CLI path (defaults to 'agy' in system PATH)
AGY_PATH=agy

# Target App URL (defaults to bundled sample app http://localhost:8080)
TARGET_APP_URL=http://localhost:8080

# Review Loop Chaos Flag (for testing/demoing loop 3 layout bug fix)
AUTOCAST_CHAOS=

# Oracle Mode (Ed25519 signing key PEM or file path - NEVER commit real private keys)
ORACLE_SIGNING_KEY=
# JSON map / array / PEM bundle of trusted runner Ed25519 public keys
ORACLE_TRUSTED_KEYS=
# Identifier recorded in oracle.runner_id
ORACLE_RUNNER_ID=
# Comma-separated allowlist of target hosts/origins (default: runner-started localhost URL only)
ORACLE_ALLOWED_HOSTS=
# Optional verdict webhook publisher URL and HMAC secret
ORACLE_WEBHOOK_URL=
ORACLE_WEBHOOK_SECRET=
